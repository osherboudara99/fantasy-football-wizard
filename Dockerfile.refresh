# syntax=docker/dockerfile:1

# Refresh-job image for Cloud Run Jobs (README §13): regenerates stats/news/
# embeddings, uploads them to GCS, then restarts the API's Cloud Run service.
# Needs the "refresh" extra (nflreadpy/pandas/sentence-transformers/torch) -
# intentionally never built into the lean API image (see Dockerfile).

FROM python:3.11-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra refresh

FROM python:3.11-slim
WORKDIR /app

RUN useradd --create-home --uid 1000 appuser
COPY --from=builder /app/.venv /app/.venv
COPY pipeline/ ./pipeline/
COPY llm/ ./llm/
COPY retrieval/ ./retrieval/
COPY scripts/ ./scripts/
COPY embeddings/ ./embeddings/
RUN chown -R appuser:appuser /app

ENV PATH="/app/.venv/bin:$PATH"
USER appuser

CMD ["python", "-m", "scripts.refresh_job_entrypoint"]
